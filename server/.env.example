PORT=3001
HOST=127.0.0.1
NODE_ENV=development
# Exact frontend origin: https://your-app.base44.app (no path or trailing slash)
FRONTEND_ORIGIN=
# Local: http://127.0.0.1:3001; production: your public HTTPS backend URL
BACKEND_URL=http://127.0.0.1:3001
# Enable only when exactly one trusted reverse proxy sits in front of the server
TRUST_PROXY=0
SSOJET_ISSUER=
SSOJET_CLIENT_ID=
SSOJET_CLIENT_SECRET=
# Generate a random value of at least 32 characters; keep stable across restarts
SESSION_SECRET=
OPENAI_API_KEY=
# Set to an account-accessible model supporting images and structured outputs
OPENAI_MODEL=
EXA_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
MONGODB_URI=
MONGODB_DATABASE=thrive
